{
  "mappings": [
    {
      "name": "pg-pay-invalid-amount",
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPath": "/pg/pay",
        "bodyPatterns": [
          {
            "matchesJsonPath": {
              "expression": "$.amount",
              "matches": "^(-[0-9]+|0)$"
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"success\":false,\"paymentId\":null,\"pgTransactionId\":null,\"amount\":{{jsonPath request.body '$.amount'}},\"status\":\"FAILED\",\"message\":\"결제 금액이 유효하지 않습니다\",\"createdAt\":\"{{now format='yyyy-MM-dd HH:mm:ss'}}\"}",
        "transformers": ["response-template"]
      }
    },
    {
      "name": "pg-pay-amount-limit-exceeded",
      "priority": 2,
      "request": {
        "method": "POST",
        "urlPath": "/pg/pay",
        "bodyPatterns": [
          {
            "matchesJsonPath": {
              "expression": "$.amount",
              "matches": "^(100000[1-9]|10000[1-9][0-9]|1000[1-9][0-9]{2}|100[1-9][0-9]{3}|10[1-9][0-9]{4}|1[1-9][0-9]{5}|[2-9][0-9]{6}|[1-9][0-9]{7,})$"
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"success\":false,\"paymentId\":null,\"pgTransactionId\":null,\"amount\":{{jsonPath request.body '$.amount'}},\"status\":\"FAILED\",\"message\":\"결제 한도(1,000,000원)를 초과했습니다\",\"createdAt\":\"{{now format='yyyy-MM-dd HH:mm:ss'}}\"}",
        "transformers": ["response-template"]
      }
    },
    {
      "name": "pg-pay-cash-not-supported",
      "priority": 3,
      "request": {
        "method": "POST",
        "urlPath": "/pg/pay",
        "bodyPatterns": [
          {
            "matchesJsonPath": {
              "expression": "$.paymentMethod",
              "equalTo": "CASH"
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"success\":false,\"paymentId\":null,\"pgTransactionId\":null,\"amount\":{{jsonPath request.body '$.amount'}},\"status\":\"FAILED\",\"message\":\"지원하지 않는 결제수단입니다 (CASH)\",\"createdAt\":\"{{now format='yyyy-MM-dd HH:mm:ss'}}\"}",
        "transformers": ["response-template"]
      }
    },
    {
      "name": "pg-pay-success",
      "priority": 10,
      "request": {
        "method": "POST",
        "urlPath": "/pg/pay"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"success\":true,\"paymentId\":\"{{jsonPath request.body '$.orderId'}}\",\"pgTransactionId\":\"mock-{{randomValue type='UUID'}}\",\"amount\":{{jsonPath request.body '$.amount'}},\"status\":\"SUCCESS\",\"message\":\"결제가 성공적으로 처리되었습니다\",\"createdAt\":\"{{now format='yyyy-MM-dd HH:mm:ss'}}\",\"modifiedAt\":\"{{now format='yyyy-MM-dd HH:mm:ss'}}\"}",
        "transformers": ["response-template"]
      }
    }
  ]
}
